// Prisma schema for the ACT Tutor ("Mr. Kim") app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  goalScore      Int
  testDate       DateTime?

  // Baseline: either submitted directly, or derived from the diagnostic test.
  // Either way, the diagnostic itself is still mandatory before a plan is built.
  hasSubmittedScore Boolean @default(false)
  currentScore      Int?
  englishScore      Int?
  mathScore         Int?
  readingScore      Int?
  scienceScore      Int?

  diagnosticCompleted Boolean @default(false)
  onboardingComplete  Boolean @default(false)

  // Scheduling inputs, captured during onboarding, used for daily/weekly plan
  // pacing and the goal-realism feasibility check.
  studyDaysPerWeek  Int      @default(5)
  minutesPerSession Int      @default(30)
  preferredSection  Section?

  // Post-diagnostic onboarding sequence (reveal -> tour -> skill polygons ->
  // question-type choice -> goal check) — gates whether "/" redirects into
  // that sequence or straight to the dashboard.
  tourCompleted             Boolean  @default(false)
  explainQuestionTypesFirst Boolean?
  goalRealismAcknowledged   Boolean  @default(false)

  // Lesson-round cycle: round 1 is the fixed foundational sequence; round 2+
  // are targeted at newly-identified weak points after each test/diagnostic.
  currentRound                Int       @default(1)
  roundAssessmentType         TestKind?
  roundAssessmentScheduledFor DateTime?
  roundFollowUpPending        Boolean   @default(false)

  // Daily goals / streaks / points (reward system).
  points           Int      @default(0)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime?

  // Daily reminder scaffold (opt-in; actual sending needs an email/SMS provider — see src/lib/reminders.ts).
  reminderEmailEnabled Boolean @default(false)
  reminderSmsEnabled   Boolean @default(false)
  reminderEmail        String?
  reminderPhone        String?
  reminderTime         String  @default("18:00") // "HH:MM", local to the student

  attempts     QuestionAttempt[]
  masteries    Mastery[]
  plans        StudyPlan[]
  testAttempts TestAttempt[]
}

enum Section {
  ENGLISH
  MATH
  READING
  SCIENCE
}

enum QuestionMode {
  DIAGNOSTIC
  PRACTICE
  RECALIBRATION
  FULL_LENGTH
}

enum TestKind {
  DIAGNOSTIC
  RECALIBRATION
  FULL_LENGTH
}

model TestAttempt {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  kind      TestKind
  createdAt DateTime @default(now())

  composite    Int?
  englishScore Int?
  mathScore    Int?
  readingScore Int?
  scienceScore Int?
}

model Question {
  id         String   @id @default(cuid())
  section    Section
  subtopic   String
  difficulty Int      @default(2) // 1 (easy) - 5 (hard)
  passage    String? // optional shared passage/context text
  prompt     String
  choicesJson String  // JSON-encoded string[]
  correctIndex Int
  explanation String
  inDiagnostic Boolean @default(false) // included in the half-length diagnostic pool

  attempts QuestionAttempt[]
}

model QuestionAttempt {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now())
  studentId  String
  student    Student      @relation(fields: [studentId], references: [id])
  questionId String
  question   Question     @relation(fields: [questionId], references: [id])
  mode       QuestionMode
  section    Section
  subtopic   String
  correct    Boolean
  selectedIndex Int
  // Groups attempts made together into one "session" for the History tab —
  // one id per diagnostic/full-length submission batch, or per practice-set
  // component mount.
  sessionId  String       @default(cuid())
}

model Mastery {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  section   Section
  subtopic  String
  score     Float    @default(0.3) // 0..1 estimated mastery
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, section, subtopic])
}

model StudyPlan {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  summary   String // Mr. Kim's generated overview text
  weeksUntilTest Int?

  items StudyPlanItem[]
}

enum PlanItemType {
  LESSON
  PRACTICE
}

enum PlanItemStatus {
  PENDING
  DONE
}

model StudyPlanItem {
  id         String         @id @default(cuid())
  planId     String
  plan       StudyPlan      @relation(fields: [planId], references: [id])
  order      Int
  type       PlanItemType
  section    Section
  subtopic   String
  title      String
  rationale  String // why Mr. Kim assigned this
  status     PlanItemStatus @default(PENDING)
  scheduledFor DateTime? // which calendar day this item is slated for (daily scheduling)
  round        Int      @default(1) // 1 = fixed foundational round; 2+ = targeted at weak points
}
